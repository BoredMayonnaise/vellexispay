# Neon project orange-flower-68071767, branch dev.
# Pooled (transaction mode) — runtime queries.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct (no pooler) — `prisma migrate` cannot run on the transaction-mode pooler.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"
# Bearer token gating the dashboard. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DASHBOARD_TOKEN="replace-with-32-random-bytes-hex"